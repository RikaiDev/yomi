{
  "name": "@rikaidev/yomi",
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=23.4.0"
  },
  "version": "0.5.0",
  "description": "Open-source personal LINE MCP server for AI agents. Read, reply, send images, and search LINE conversations locally with Letter-Sealing E2EE.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://rikaidev.github.io/yomi/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RikaiDev/yomi.git"
  },
  "bugs": {
    "url": "https://github.com/RikaiDev/yomi/issues"
  },
  "keywords": [
    "line",
    "mcp",
    "model-context-protocol",
    "e2ee",
    "messaging",
    "chat"
  ],
  "bin": {
    "yomi": "run.mjs"
  },
  "files": [
    "run.mjs",
    "dist",
    "README.md",
    "NOTICE",
    "LICENSE",
    "PRIVACY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node run.mjs",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "lint:comments": "node scripts/lint-comments.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "pretest": "npm run lint:comments && npm run test:fixture-hygiene",
    "format": "biome format --write src/",
    "test": "bun test",
    "predesktop:build": "npm run build",
    "desktop:build": "bash scripts/build-swift-desktop.sh",
    "desktop:clean": "node scripts/clean-desktop-artifacts.mjs",
    "desktop:clean:all": "node scripts/clean-desktop-artifacts.mjs --all",
    "desktop:harness": "node scripts/desktop-harness.mjs",
    "desktop:qos": "node scripts/desktop-qos-harness.mjs",
    "desktop:flex-parity": "npm run build && node scripts/flex-layout-parity-harness.mjs",
    "desktop:swift-quality": "bash scripts/swift-quality.sh",
    "desktop:i18n-harness": "node scripts/swift-i18n-harness.mjs",
    "desktop:restart": "node scripts/desktop-harness.mjs --restart",
    "desktop:run": "./desktop/mac-native/Yomi.app/Contents/MacOS/Yomi",
    "desktop:core:macos": "node scripts/package-desktop-core.mjs --platform macos --output build/desktop-core-macos --semantic full",
    "desktop:core:windows": "node scripts/package-desktop-core.mjs --platform windows --output build/desktop-core-windows --semantic full",
    "desktop:package:harness": "node scripts/desktop-package-harness.mjs",
    "desktop:windows:build": "cargo build --manifest-path desktop/Cargo.toml --release --target x86_64-pc-windows-msvc",
    "desktop:windows:lint": "cargo fmt --manifest-path desktop/Cargo.toml -- --check && cargo clippy --manifest-path desktop/Cargo.toml --target x86_64-pc-windows-msvc -- -D warnings",
    "desktop:windows:qc": "npm run typecheck && npm run lint && npm run lint:comments && cargo test --manifest-path desktop/Cargo.toml && npm run desktop:windows:lint",
    "desktop:windows:i18n": "node scripts/windows-i18n-harness.mjs",
    "desktop:windows:harness": "node scripts/windows-desktop-harness.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "npm run build",
    "test:fixture-hygiene": "node scripts/test-fixture-hygiene.mjs",
    "desktop:install-local": "bash scripts/install-swift-desktop-local.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@toon-format/toon": "^2.3.1",
    "curve25519-js": "^0.0.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "knip": "^6.27.0",
    "typescript": "^7.0.0"
  }
}
