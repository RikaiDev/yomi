{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/mcp/server.ts",
    "src/mcp/integrator.ts",
    "src/cli/login.ts",
    "src/cli/query.ts",
    "src/cli/work-item.ts",
    "src/version.ts",
    "scripts/*.mjs",
    "src/**/*.test.ts"
  ],
  "project": ["src/**/*.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/work-item/destination-contracts.ts": ["types"],
    "src/work-item/gold-coverage.ts": ["exports"],
    "src/ambient/ambient-observer.ts": ["exports"],
    "src/work-item/types.ts": ["exports"]
  },
  "ignoreBinaries": ["security", "defaults", "sw_vers", "ffmpeg", "swiftc", "pkill", "ps"]
}
